# ---------------------------------------------------------------------------
# Ultimate POS — .env for the Docker stack.
#
#   cp .env.docker.example .env
#   docker compose run --rm --no-deps app php artisan key:generate --show
#   (paste the result into APP_KEY below, then `docker compose up -d`)
#
# This one file is read by two things: the app containers bind-mount it, and
# docker compose reads DB_*/REDIS_PASSWORD/HTTP_* from it to configure the
# database, Redis and the published port. Keep it out of version control, and
# leave it mode 664 (not 600) — see DOCKER.md.
#
# EDITING RULE, because the superadmin settings screen also writes this file:
# it saves a setting by replacing every line that *contains* the key name, as a
# plain substring, with no regard for whether the line is a comment or a
# different setting. So for any key that screen manages — the mail block, the
# payment gateway keys, the backup disk, the pusher block, the app name/title/
# locale, registration — never write that key's name inside a comment, and
# never refer to one from another line with "${...}". Both get silently
# overwritten the first time someone saves that settings form. Values written
# literally are safe; that is why a couple of them below are spelled out.
# ---------------------------------------------------------------------------

APP_NAME="Yaigo POS"
APP_TITLE=""

# IMPORTANT: use "live", not "production". app/Console/Kernel.php only registers
# the scheduled jobs (daily backup, recurring invoices, reward points, payment
# reminders, recurring expenses) when APP_ENV === 'live'.
APP_ENV=live
APP_DEBUG=false
APP_LOG_LEVEL=error

# Required. Generate once (command above) and never change it on a live
# database: encrypted columns and existing sessions are tied to it.
APP_KEY=

# The public URL of this site, including the scheme and — unless you are on
# 80/443 — the port.
#
# READ THIS BEFORE CHANGING IT. The scheme here is the single switch that
# decides whether the app emits http:// or https:// links for every css, js
# and image URL: app/Providers/AppServiceProvider.php calls
# URL::forceScheme('https') if, and only if, APP_URL starts with https://.
# It only rewrites the scheme, never the host — so an https APP_URL while you
# browse over plain http gives you a page that loads with every asset pointing
# at https://localhost:<port>/... and failing.
#
#   local, over HTTP_PORT below   ->  APP_URL=http://localhost:8080
#   live, TLS in front, on 443    ->  APP_URL=https://pos.example.com
#
# Keep this in step with HTTP_PORT further down.
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_TIMEZONE="Asia/Kolkata"

ADMINISTRATOR_USERNAMES=admin
ALLOW_REGISTRATION=false
ENABLE_GST_REPORT_INDIA=
SHOW_REPAIR_STATUS_LOGIN_SCREEN=true

LOG_CHANNEL=daily

POS_RECENT_TRANSACTIONS_DISPLAY_LIMIT=10

# ---------------------------------------------------------------------------
# Database — the "db" service. DB_HOST must be the service name.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ultimatepos
# Must NOT be "root": the MySQL image refuses to create a user by that name.
DB_USERNAME=ultimatepos
DB_PASSWORD=change-me-strong-password
# Used only to initialise the MySQL container and for admin/backup access.
DB_ROOT_PASSWORD=change-me-different-strong-password

# ---------------------------------------------------------------------------
# Redis — the "redis" service. Required; the stack will not start without a
# password. Generate one with: openssl rand -base64 32
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_CLIENT=phpredis

CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Set true once the site is served over HTTPS (and APP_URL says https).
SESSION_SECURE_COOKIE=false

# The "queue" container processes this. Set to "sync" to run jobs inline
# instead (then the queue container has nothing to do).
QUEUE_CONNECTION=redis

BROADCAST_DRIVER=log

# ---------------------------------------------------------------------------
# Published HTTP port
#
# Must agree with the port in APP_URL above. Going live on a domain: set this
# to 80 (or keep 8080 and put a TLS reverse proxy in front — then also set
# HTTP_BIND=127.0.0.1 so nginx is not reachable from the internet directly).
# ---------------------------------------------------------------------------
HTTP_BIND=0.0.0.0
HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Adminer — web UI for browsing the database.
#
# Bound to localhost by default: an unauthenticated-until-you-log-in database
# console should not be open to the internet. On a remote server, reach it
# through an SSH tunnel (see DOCKER.md) rather than setting ADMINER_BIND to
# 0.0.0.0. Log in with the DB_USERNAME / DB_PASSWORD above; the server field
# is prefilled with "db".
# ---------------------------------------------------------------------------
ADMINER_BIND=127.0.0.1
ADMINER_PORT=8081

# Run `php artisan migrate --force` automatically when the app container
# starts. Leave false on a live database and migrate deliberately.
AUTO_MIGRATE=false

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
# Written out in full on purpose — see the warning at the top of this file
# about referring to one managed key from another line.
MAIL_FROM_NAME="Ultimate POS"

# ---------------------------------------------------------------------------
# Backups (spatie/laravel-backup, run daily by the scheduler container)
#
# "local" is the disk from config/filesystems.php, rooted at public/uploads —
# so backups land in the uploads volume. nginx blocks .zip/.sql there, but
# copy them off the server regularly, or switch the disk below to s3/dropbox.
# ---------------------------------------------------------------------------
BACKUP_DISK=local
DROPBOX_ACCESS_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# ---------------------------------------------------------------------------
# Third-party integrations — fill in the ones you actually use.
# ---------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

ENVATO_PURCHASE_CODE=
MAC_LICENCE_CODE=

GOOGLE_MAP_API_KEY=

STRIPE_PUB_KEY=
STRIPE_SECRET_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
# Set this literally; do not point it at another key (see the top of this file).
MERCHANT_EMAIL=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

MY_FATOORAH_API_KEY=
MY_FATOORAH_IS_TEST=
MY_FATOORAH_COUNTRY_ISO=

ENABLE_RECAPTCHA="false"
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

DO_NOT_ALLOW_DISPOSABLE_EMAIL=
