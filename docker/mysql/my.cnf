# Ultimate POS — MySQL 8.0 server settings.

[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# config/database.php sets 'strict' => false, so Laravel already relaxes
# sql_mode per session. Match it at the server level too, otherwise importing
# the dumps in database/backup/ with the mysql client trips over
# ONLY_FULL_GROUP_BY and zero dates.
sql_mode = NO_ENGINE_SUBSTITUTION

# Large product/transaction imports and mysqldump backups.
max_allowed_packet = 256M

# Roughly 50-70% of the RAM you give this container.
innodb_buffer_pool_size = 512M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1

max_connections = 200
wait_timeout    = 600

# Slow query visibility — output goes to the container log.
slow_query_log      = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time     = 2

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
